--
-- Name: effect_checkpoints; Type: TABLE; Schema: public; Owner: fogell
--

CREATE TABLE "public"."effect_checkpoints" (
    "organization_id" "uuid" NOT NULL,
    "attempt_id" "uuid" NOT NULL,
    "effect_key" "text" NOT NULL,
    "fence" bigint NOT NULL,
    "authority_owner" "text" NOT NULL,
    "restore_epoch" bigint NOT NULL,
    "payload_digest" "bytea" NOT NULL,
    "state" "text" NOT NULL,
    "uncertain_from" "text",
    "prepared_at" timestamp with time zone DEFAULT "clock_timestamp"() NOT NULL,
    "applied_at" timestamp with time zone,
    "confirmed_at" timestamp with time zone,
    "uncertain_at" timestamp with time zone,
    "uncertain_seq" bigint,
    CONSTRAINT "effect_checkpoints_authority_owner_check" CHECK (("btrim"("authority_owner") <> ''::"text")),
    CONSTRAINT "effect_checkpoints_check" CHECK (((("state" = 'prepared'::"text") AND ("uncertain_from" IS NULL) AND ("applied_at" IS NULL) AND ("confirmed_at" IS NULL) AND ("uncertain_at" IS NULL)) OR (("state" = 'applied'::"text") AND ("uncertain_from" IS NULL) AND ("applied_at" IS NOT NULL) AND ("confirmed_at" IS NULL) AND ("uncertain_at" IS NULL)) OR (("state" = 'confirmed'::"text") AND ("uncertain_from" IS NULL) AND ("applied_at" IS NOT NULL) AND ("confirmed_at" IS NOT NULL) AND ("uncertain_at" IS NULL)) OR (("state" = 'uncertain'::"text") AND ("uncertain_from" = 'prepared'::"text") AND ("applied_at" IS NULL) AND ("confirmed_at" IS NULL) AND ("uncertain_at" IS NOT NULL)) OR (("state" = 'uncertain'::"text") AND ("uncertain_from" = 'applied'::"text") AND ("applied_at" IS NOT NULL) AND ("confirmed_at" IS NULL) AND ("uncertain_at" IS NOT NULL)))),
    CONSTRAINT "effect_checkpoints_effect_key_check" CHECK ((("char_length"("effect_key") >= 1) AND ("char_length"("effect_key") <= 256) AND ("btrim"("effect_key") <> ''::"text"))),
    CONSTRAINT "effect_checkpoints_fence_check" CHECK (("fence" >= 0)),
    CONSTRAINT "effect_checkpoints_payload_digest_check" CHECK (("octet_length"("payload_digest") = 32)),
    CONSTRAINT "effect_checkpoints_restore_epoch_check" CHECK (("restore_epoch" >= 0)),
    CONSTRAINT "effect_checkpoints_state_check" CHECK (("state" = ANY (ARRAY['prepared'::"text", 'applied'::"text", 'confirmed'::"text", 'uncertain'::"text"]))),
    CONSTRAINT "effect_checkpoints_uncertain_from_check" CHECK (("uncertain_from" = ANY (ARRAY['prepared'::"text", 'applied'::"text"]))),
    CONSTRAINT "effect_checkpoints_uncertain_seq_check" CHECK ((("state" = 'uncertain'::"text") = ("uncertain_seq" IS NOT NULL)))
);

ALTER TABLE ONLY "public"."effect_checkpoints" FORCE ROW LEVEL SECURITY;


ALTER TABLE "public"."effect_checkpoints" OWNER TO "fogell";

