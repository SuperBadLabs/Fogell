--
-- Name: retry_decisions; Type: TABLE; Schema: public; Owner: fogell
--

CREATE TABLE "public"."retry_decisions" (
    "organization_id" "uuid" NOT NULL,
    "parent_attempt_id" "uuid" NOT NULL,
    "parent_node_id" "uuid" NOT NULL,
    "parent_ordinal" integer NOT NULL,
    "parent_retry_of" "uuid",
    "parent_restore_epoch" bigint NOT NULL,
    "attempt_limit" integer NOT NULL,
    "outcome" "text" NOT NULL,
    "child_attempt_id" "uuid",
    "dead_letter_reason" "text",
    "decided_at" timestamp with time zone DEFAULT "clock_timestamp"() NOT NULL,
    CONSTRAINT "retry_decisions_attempt_limit_check" CHECK (("attempt_limit" > 0)),
    CONSTRAINT "retry_decisions_check" CHECK (((("outcome" = 'child_created'::"text") AND ("child_attempt_id" IS NOT NULL) AND ("dead_letter_reason" IS NULL)) OR (("outcome" = 'budget_exhausted'::"text") AND ("child_attempt_id" IS NULL) AND ("dead_letter_reason" = 'attempt budget exhausted'::"text")))),
    CONSTRAINT "retry_decisions_outcome_check" CHECK (("outcome" = ANY (ARRAY['child_created'::"text", 'budget_exhausted'::"text"]))),
    CONSTRAINT "retry_decisions_parent_ordinal_check" CHECK ((("parent_ordinal" >= 0) AND ("parent_ordinal" < 2147483647))),
    CONSTRAINT "retry_decisions_parent_restore_epoch_check" CHECK (("parent_restore_epoch" >= 0))
);

ALTER TABLE ONLY "public"."retry_decisions" FORCE ROW LEVEL SECURITY;


ALTER TABLE "public"."retry_decisions" OWNER TO "fogell";

