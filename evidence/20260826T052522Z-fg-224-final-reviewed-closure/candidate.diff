+            let close = value.LastIndexOf ')'
+
+            if close < 0 || close + 2 >= value.Length then
+                IdentityUncertain
+            else
+                let fields =
+                    value.Substring(close + 2).Split(' ', StringSplitOptions.RemoveEmptyEntries)
+
+                if fields.Length <= 19 then
+                    IdentityUncertain
+                elif
