+                        cycle <- true
+                        0
+                    else
+                        compareLists ((box xs, box ys) :: seen) xs.Value ys.Value
+                | VMap xs, VMap ys ->
+                    if seenPair seen (box xs) (box ys) then
+                        cycle <- true
+                        0
+                    else
+                        compareEntries
+                            ((box xs, box ys) :: seen)
+                            (Map.toList xs.Value)
+                            (Map.toList ys.Value)
+                | VClosure _, VClosure _
+                | VFunc _, VFunc _ ->
+                    unorderable <- true
+                    0
+                | _ -> 0
+
+        and compareLists seen left right =
