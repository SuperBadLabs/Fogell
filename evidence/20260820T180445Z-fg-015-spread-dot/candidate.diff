+                    }
+                    capture('null_receiver') {
+                        def rows = null
+                        rows*.name
+                    }
+                    capture('nested_projection') {
+                        def groups = [[child: [name: 'a']], [child: null], [child: [name: 'b']]]
+                        groups*.child*.name
