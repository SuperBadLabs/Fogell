+            echo "compound:caught:${e.class.simpleName}:${rows[0].child.extra}:${rows[1].child.extra}"
+          }
+
+          try {
+            rows*.count[0]++
+            echo "increment:ok:${rows[0].count}:${rows[1].count}"
+          } catch (Exception e) {
+            echo "increment:caught:${e.class.simpleName}:${rows[0].count}:${rows[1].count}"
