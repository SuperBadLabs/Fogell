+                    start + count < value.Length
+                    && Char.IsHighSurrogate value[start + count - 1]
+                    && Char.IsLowSurrogate value[start + count]
+                then
+                    count <- count - 1
+
+                append (value.Substring(start, count))
+                start <- start + count
