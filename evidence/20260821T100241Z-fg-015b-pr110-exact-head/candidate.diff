+  workspace-hash: e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
+  output (1 lines):
+    | display:[interpolation-escaped-exception, tostring-caught-error, direct-list=[(this Collection)], direct-map=[self:(this Map)]]
+
+## Fogell
+  result:         success
+  workspace-hash: e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
+  output (1 lines):
+    | display:[interpolation-escaped-exception, tostring-caught-error, direct-list=[(this Collection)], direct-map=[self:(this Map)]]
